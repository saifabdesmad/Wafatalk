# WafaTalk Backend Environment Variables
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Frontend Origins (CORS & Socket.IO)
FRONTEND_URL=http://localhost:8085,http://localhost:5173,https://wafatalk.vercel.app

# Security
JWT_SECRET=wafatalk_dev_secret_key_change_in_production_2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Database Connection (Default SQLite for instant local dev, or PostgreSQL for Production/Docker)
# For local zero-config: file:./dev.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/wafatalk?schema=public
DATABASE_URL=file:./dev.db

# Redis Connection (Cache, Sessions, Socket.IO Scaling)
# If Redis is unavailable locally, the server falls back to high-speed in-memory pub-sub
REDIS_URL=redis://localhost:6379
ENABLE_REDIS=false
